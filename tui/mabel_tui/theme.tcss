/* Colours come from palette.py ($mo-* variables).
   MABEL-OS: amber phosphor on a beige 1980s terminal. Cassette-futurism, a little anime cockpit HUD. */


Screen {
    background: $mo-bg;
    color: $mo-amber;
}

/* ── the casing: label strip on top, status strip at the bottom ── */
#casing {
    dock: top;
    height: 1;
    background: $mo-beige;
    padding: 0 1;
}
#casing-left { width: 1fr; }
#casing-clock { width: auto; }
#bottom {
    dock: bottom;
    height: 2;
}
#statusline {
    height: 1;
    background: $mo-beige-dark;
    color: $mo-casing-text;
    padding: 0 1;
}
Footer {
    dock: none;
    height: 1;
    background: $mo-panel;
}
FooterKey { background: $mo-panel; color: $mo-amber-dim; }
FooterKey .footer-key--key { background: $mo-amber-faint; color: $mo-amber-hi; text-style: bold; }
FooterKey:hover { background: $mo-amber-faint; }

* {
    scrollbar-color: $mo-amber-dim;
    scrollbar-color-hover: $mo-amber;
    scrollbar-color-active: $mo-amber-hi;
    scrollbar-background: $mo-panel;
    scrollbar-background-hover: $mo-panel;
    scrollbar-background-active: $mo-panel;
    scrollbar-corner-color: $mo-panel;
    scrollbar-size-vertical: 1;
}

/* ── channel tabs ── */
TabbedContent { background: $mo-bg; height: 1fr; }
ContentSwitcher { height: 1fr; }
Tabs { background: $mo-bg; }
Tab {
    color: $mo-amber-dim;
    text-style: bold;
    padding: 0 2;
}
Tab:hover { color: $mo-amber-hi; }
Tab.-active {
    background: $mo-amber;
    color: $mo-bg;
}
Underline > .underline--bar { color: $mo-amber-faint; background: $mo-bg; }
TabPane { padding: 0; height: 1fr; }

/* ── panels ── */
.panel {
    border: round $mo-amber-dim;
    border-title-color: $mo-beige;
    border-title-style: bold;
    border-subtitle-color: $mo-amber-dim;
    background: $mo-panel;
    padding: 0 1;
}
.panel:focus-within { border: round $mo-amber; }
.dim { color: $mo-amber-dim; }
.hud { color: $mo-teal; }
.warn { color: $mo-red; }

Input {
    background: $mo-panel;
    color: $mo-amber-hi;
    border: tall $mo-amber-dim;
}
Input:focus { border: tall $mo-amber; }
Input > .input--placeholder { color: $mo-amber-faint; }
Input > .input--cursor { background: $mo-amber; color: $mo-bg; }

ListView, OptionList, DataTable { background: $mo-panel; color: $mo-amber; }
ListView > ListItem.-highlight, OptionList > .option-list--option-highlighted {
    background: $mo-amber-faint;
    color: $mo-amber-hi;
}
DataTable > .datatable--header { background: $mo-amber-faint; color: $mo-beige; text-style: bold; }
DataTable > .datatable--cursor { background: $mo-amber; color: $mo-bg; }
DataTable > .datatable--hover { background: $mo-amber-faint; }

Button {
    background: $mo-amber-faint;
    color: $mo-amber-hi;
    border: tall $mo-amber-dim;
    min-width: 12;
}
Button:hover { background: $mo-amber-dim; color: $mo-bg; }
Button.-primary { background: $mo-amber; color: $mo-bg; border: tall $mo-amber-hi; }
Button.-error { background: #4a1408; color: $mo-red; border: tall $mo-red; }

ProgressBar Bar > .bar--bar { color: $mo-amber; background: $mo-amber-faint; }
ProgressBar Bar > .bar--complete { color: $mo-teal; }

Markdown { background: transparent; color: $mo-amber; margin: 0; padding: 0; }
MarkdownH1, MarkdownH2, MarkdownH3 { color: $mo-amber-hi; background: transparent; }
MarkdownFence { background: $mo-amber-faint; color: $mo-amber-hi; }

/* ── COMMS ── */
#comms-view { layout: horizontal; }
#sessions { width: 30; }
#sessions.-hidden { display: none; }
#chat-col { width: 1fr; }
#log { height: 1fr; padding: 0 1; }
#prompt { dock: bottom; margin: 0 0; }
.msg { margin: 1 0 0 0; height: auto; }
.msg-head { color: $mo-beige-dark; text-style: bold; height: 1; }
.msg.-user .msg-head { color: $mo-teal; }
.msg.-user Markdown { color: $mo-amber-hi; }
.tool-line { color: $mo-amber-dim; height: auto; padding-left: 2; }
.approval { border: heavy $mo-red; background: #1e0c05; height: auto; padding: 0 1; margin: 1 0 0 0; }
.approval Horizontal { height: auto; }
.approval Button { margin-right: 2; }

/* ── LIFE ── */
#life-view { layout: grid; grid-size: 3 2; grid-columns: 1fr 1fr 1fr; grid-rows: 1fr 1fr; width: 1fr; height: 1fr; }
#life-status { row-span: 2; }
#life-dream { row-span: 2; }
#dream-image { height: 14; width: 100%; }

/* ── AUDIO ── */
#audio-view { layout: horizontal; }
#browser { width: 3fr; }
#deck { width: 2fr; }
#search { margin: 0 0 1 0; }
#results { height: 1fr; }
#cover { height: 14; width: 30; }
#nowplaying { height: auto; margin: 1 0; }
#queue { height: 1fr; }
#dream-holder { height: auto; }
#cover-holder { height: auto; }

/* ── INVENTORY ── */
#inventory-view { layout: horizontal; }
#inv-main { width: 3fr; }
#inv-item { width: 2fr; }
#inv-search { margin: 0 0 0 0; }
#inv-crumbs { height: auto; margin: 0 0 1 0; }
#inv-body { height: 1fr; }
.pcards { grid-size: 4; grid-gutter: 1 2; grid-rows: 4; height: auto; margin: 0 0 1 0; }
.pcard { border: round $mo-amber-dim; padding: 0 1; height: 4; background: $mo-panel; }
.pcard:focus { border: round $mo-amber; background: $mo-amber-faint; }
.pcard:hover { border: round $mo-amber-hi; }
.thing, .level, .suggestion { height: auto; padding: 0 1; }
.thing:focus, .level:focus, .suggestion:focus { background: $mo-amber-faint; }
.thing:hover, .level:hover, .suggestion:hover { background: $mo-amber-faint; }
.suggestion { margin: 0 0 1 0; }
.sec { height: auto; }
.sec:focus { background: $mo-amber-faint; }
.map { height: auto; width: auto; }
.legend { height: auto; margin: 0 0 1 0; }
#inv-photo { height: auto; }
#inv-image { width: 28; height: 14; }
#inv-card { height: auto; }

Ask { align: center middle; background: rgba(12, 8, 4, 0.7); }
#ask { width: 80; height: auto; max-height: 90%; background: $mo-panel; border: heavy $mo-amber; padding: 0 1; }
.ask-label { color: $mo-beige; margin: 1 0 0 0; }
.ask-area { height: 5; background: $mo-bg; color: $mo-amber-hi; }
.ask-buttons { height: 3; dock: bottom; background: $mo-panel; }
.ask-buttons Button { margin-right: 2; }
Select { background: $mo-panel; }
SelectCurrent { background: $mo-panel; color: $mo-amber-hi; border: tall $mo-amber-dim; }
.level { text-wrap: nowrap; text-overflow: ellipsis; }
HelpScreen { align: center middle; background: rgba(12, 8, 4, 0.7); }
#help { width: 92; height: auto; background: $mo-panel; border: heavy $mo-amber; padding: 1 2; }
PickPlaylist { align: center middle; background: rgba(12, 8, 4, 0.7); }
#pick-playlist { width: 60; height: auto; max-height: 70%; background: $mo-panel; border: heavy $mo-amber; }

/* ── nav mode: the lit section ── */
.section.-nav { border: heavy $mo-amber-hi; background: $mo-amber-faint; }
Input.section.-nav { border: tall $mo-amber-hi; background: $mo-panel; }
Input.section.-nav > .input--placeholder { color: $mo-amber-dim; }

/* ── narrow (the 7" cyberdeck, 1024×600 ≈ 128×37): stacked panels; the PC layout above is untouched ── */
.-narrow #sessions { display: none; }
.-narrow #sessions.-shown { display: block; width: 26; }
.-narrow #life-view { grid-size: 2 2; grid-columns: 1fr 1fr; grid-rows: 1fr 1fr; }
.-narrow #life-status, .-narrow #life-dream { row-span: 1; }
.-narrow #dream-image { height: 10; }
.-narrow #audio-view { layout: vertical; }
.-narrow #browser { width: 100%; height: 1fr; }
.-narrow #deck { width: 100%; height: 13; layout: grid; grid-size: 2 3; grid-columns: 24 1fr; grid-rows: auto 1 1fr; }
.-narrow #cover-holder { row-span: 3; }
.-narrow #cover { width: 22; height: 11; }
.-narrow #nowplaying { margin: 0 0; }
.-narrow #inventory-view { layout: vertical; }
.-narrow #inv-main { width: 100%; height: 3fr; }
.-narrow #inv-item { width: 100%; height: 2fr; }
.-narrow .pcards { grid-size: 3; }
.-narrow #inv-image { width: 22; height: 11; }
Tuner { align: center middle; background: rgba(12, 8, 4, 0.6); }
#tuner { width: 96; height: auto; max-height: 90%; background: $mo-panel; border: heavy $mo-amber; padding: 0 1; }

/* ── VAULT ── */
#vault-view { layout: horizontal; }
#vault-explorer { width: 32; }
#vault-note { width: 1fr; }
#vault-side { width: 36; }
#vault-side.-hidden { display: none; }
#vault-meta { height: auto; margin: 0 0 1 0; }
#vault-switch { height: 1fr; }
#vault-read { height: 1fr; }
#vault-edit { height: 1fr; border: none; padding: 0 1; }
#vault-status { height: 1; dock: bottom; }
#vault-md { margin: 0 1; }
Picker { align: center middle; background: rgba(12, 8, 4, 0.7); }
#picker { width: 80; height: auto; max-height: 80%; background: $mo-panel; border: heavy $mo-amber; padding: 0 1; }
#picker-list { height: auto; max-height: 24; }
.-narrow #vault-explorer { width: 28; }
.-narrow #vault-side { display: none; }
.-narrow #vault-side.-shown { display: block; width: 32; }

/* ── TERM ── */
#term-view { height: 1fr; }
#term-tabs { height: 1; padding: 0 1; }
#term-switch { height: 1fr; padding: 0; }
Terminal { width: 1fr; height: 1fr; }

/* ── COMMS: Mabel's portrait ── */
#mabel-side { width: 30; height: 1fr; }
#portrait { width: 30; height: 16; padding: 0; }
#mabel-state { width: 30; height: 1; content-align: center middle; text-align: center; margin-top: 1; }

/* ── CH-07 CREATIVE ── */
.suite-bar { height: 1; background: $mo-panel; }
.suite-apps, #pixel, #pixel-main { height: 1fr; }
#pixel-left { width: 24; }
#pixel-tools { height: auto; }
#pixel-palette { height: 1fr; }
#pixel-canvas { width: 1fr; height: 1fr; padding: 0; background: $mo-bg; }
#pixel-right { width: 32; }
#pixel-preview { height: 17; }
#pixel-preview-img { height: 1fr; }
#pixel-layers { height: auto; max-height: 12; }
#pixel-frames { height: 1fr; }
#pixel-status { height: 1; background: $mo-panel; }
#tracker { height: 1fr; }
#trk-main { height: 1fr; }
#trk-song { width: 32; height: 1fr; }
#trk-chain { width: 15; height: 1fr; }
#trk-phrase { width: 24; height: 1fr; }
#trk-right { width: 1fr; }
#trk-inst { height: 15; }
#trk-table { height: 1fr; min-height: 8; }
#trk-wave { height: 8; }
#trk-status { height: 1; background: $mo-panel; }

/* ── CREATIVE file browser ── */
Browser { align: center middle; background: $mo-bg 60%; }
#browser { width: 90%; height: 85%; background: $mo-panel; border: heavy $mo-amber; border-title-color: $mo-beige;
           border-title-style: bold; padding: 0 1; }
#browser-main { height: 1fr; }
#browser-list { width: 1fr; height: 1fr; }
#browser-preview { width: 42%; height: 1fr; border-left: vkey $mo-amber-faint; padding-left: 1; }
#browser-help { height: 1; }
#browser-input { height: 3; }

/* ── CH-08 SYS ── */
.sys-menu { height: 1fr; }
.sys-input { height: 3; }

/* ── COMMS · INBOX ── */
#inbox-main { height: 1fr; }
#inbox-chats { width: 42; height: 1fr; }
#inbox-right { width: 1fr; }
#inbox-conv { height: 1fr; }
#inbox-compose { height: 3; }
.comms-holder { height: 1fr; }
